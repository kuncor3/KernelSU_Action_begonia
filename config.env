CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/HMD-OSS-Archive/android_kernel_nokia_5.1_plus.git
KERNEL_SOURCE_BRANCH=hmd/Nokia_5.1-plus
KERNEL_CONFIG=PDA_defconfig
ARCH=arm64
KERNEL_FILE=Image.gz-dtb
EXTRA_BUILD_COMMAND:LD=ld.lld
DISABLE-LTO=false
ENABLE_KERNELSU=true
ADD_KPROBES_CONFIG=false
