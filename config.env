CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_xiaomi_sm6250.git
KERNEL_SOURCE_BRANCH=lineage-22.2
KERNEL_CONFIG=vendor/xiaomi/miatoll_defconfig
ARCH=arm64
KERNEL_FILE=Image
EXTRA_BUILD_COMMAND:LD=ld.lld:READELF=llvm-readelf:OBJCOPY=llvm-objcopy:OBJDUMP=llvm-objdump:STRIP=llvm-strip:NM=llvm-nm:AR=llvm-ar
DISABLE-LTO=false
ENABLE_KERNELSU=true
KERNELSU_SOURCE=https://github.com/ReSukiSU/ReSukiSU.git
KERNELSU_BRANCH=main
ENABLE_SUSFS=true
ENABLE_NOMOUNT=false
APPLY_CUSTOM_PATCH=true
