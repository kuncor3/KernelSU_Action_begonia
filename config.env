CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_xiaomi_sm6250.git
KERNEL_SOURCE_BRANCH=lineage-22.2
KERNEL_CONFIG=vendor/xiaomi/miatoll_defconfig
ARCH=arm64
KERNEL_FILE=Image
EXTRA_BUILD_COMMAND:LD=ld.lld
DISABLE-LTO=false
ENABLE_KERNELSU=true
ENABLE_SUSFS=true
APPLY_CUSTOM_PATCH=true
