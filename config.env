CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/HMD-OSS-Archive/android_kernel_nokia_5.1_plus.git
KERNEL_SOURCE_BRANCH=hmd/Nokia_5.1-plus
KERNEL_CONFIG=PDA_defconfig
ARCH=arm64
KERNEL_FILE=Image.gz-dtb
EXTRA_BUILD_COMMAND:LD=ld.lld:READELF=llvm-readelf:OBJCOPY=llvm-objcopy:OBJDUMP=llvm-objdump:STRIP=llvm-strip:NM=llvm-nm
DISABLE-LTO=true
ENABLE_KERNELSU=true
KERNELSU_SOURCE=https://github.com/Baka-SU/BakaSU
KERNELSU_BRANCH=main
ENABLE_SUSFS=false
ENABLE_NOMOUNT=false
NOMOUNT_BRANCH=master
APPLY_CUSTOM_PATCH=true
ADD_KPROBES_CONFIG=false